rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas del ranking)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado
//   reports/{tabla__id__uid}  reportes de marcas sospechosas (sólo los lee el admin)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
//   bans/{uid}             cuentas baneadas del ranking (sólo el admin)
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Moderación (pantalla oculta js/ui/mod-ui.js): sólo estas cuentas. Deben ser los mismos
    // UID que `G.FORK.admins` (js/core/fork-config.js); tras cambiarlos, despliega las reglas.
    function admin() { return signedIn() && me() in ['KNDXBqVVroOtaofexPunuc5aocw1']; }
    // Tope de escrituras (20-10-2026): un documento no se puede volver a escribir
    // hasta pasados `secs` segundos desde `last` (su hora guardada). El juego
    // escribe mucho menos que eso; esto sólo frena un bucle (un juego trucado o
    // un fallo), y lo rechazado no se cobra como escritura.
    function every(last, secs) { return !(last is timestamp) || request.time > last + duration.value(secs, 's'); }

    // ---------- partida guardada ----------
    // Sólo su dueño la lee y la escribe. Ya no se marca a nadie solo (14-10-2026:
    // los márgenes contra partidas imposibles dejaban fuera del ranking a gente
    // legal). Lo único que deja a alguien sin ranking es que el admin lo banee
    // (ban = true; el campo viejo "sus" ya no cuenta para nada). El jugador no
    // puede quitarse el baneo: si está, sus guardados tienen que llevarlo.
    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow read: if admin();
      // (Baneado no: sin documento, validEntry da por hecho que no hay baneo.)
      allow delete: if signedIn() && me() == uid && resource.data.get('ban', false) == false;

      allow create: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == false
        && request.resource.data.get('rev', 0) is int;
      allow update: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false)
        && every(resource.data.updatedAt, 20) && revOk();
      // El admin sólo puede banear o desbanear (y quitar la marca vieja).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ban', 'sus'])
        && request.resource.data.get('ban', false) is bool;
    }

    // Versión de la partida (21-10-2026): cada subida trae rev + 1 de la que vio
    // el aparato. Si otro aparato subió entre medias, la nube ya va por delante y
    // se rechaza (el juego lee, junta y vuelve a subir): una copia vieja ya no
    // pisa lo guardado en otro aparato. Mirar resource aquí no cuesta lecturas.
    // Las versiones del juego de antes no mandan rev (se queda igual): pueden
    // seguir guardando sólo mientras ningún aparato nuevo haya subido esa partida.
    function revOk() {
      let had = resource.data.get('rev', 0);
      let now = request.resource.data.get('rev', 0);
      return now is int && (now == had + 1 || (had == 0 && now == 0));
    }

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus', 'ban', 'rev'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('ban', false) is bool
        && request.resource.data.updatedAt == request.time;
    }
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    // Sólo que los números tengan sentido (el juego ya los limpia al cargar).
    // Y un tamaño razonable (28-10-2026): antes se aceptaba una partida de 900 KB con
    // cualquier cosa dentro. Una partida de verdad tiene ~55 claves.
    function saneSave(s) {
      return s.keys().size() <= 100
        && s.get('name', '') is string && s.get('name', '').size() <= 24
        && s.get('owned', {}) is map && s.get('owned', {}).size() <= 2000
        && s.get('shiny', {}) is map && s.get('shiny', {}).size() <= 2000
        && s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0
        // Pokédex de vistos y derrotados (systems/seen.js): un texto corto cada uno.
        && s.get('seen', '') is string && s.get('seen', '').size() <= 260
        && s.get('beat', '') is string && s.get('beat', '').size() <= 260;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    // Récords del perfil: sólo números (lo que pinta el perfil; nada de texto).
    function validBest(b) {
      return b is map && b.keys().hasOnly(['solo', 'group', 'level', 'bosses', 'legends', 'kills', 'medals'])
        && b.get('solo', 0) is int && b.get('group', 0) is int && b.get('level', 0) is int && b.get('bosses', 0) is int
        && b.get('legends', 0) is int && b.get('kills', 0) is int && b.get('medals', 0) is int;
    }

    // Textos de una lista corta (hasta 8): cada uno, texto de `max` letras como mucho.
    // Las reglas no recorren listas: se mira cada posición (28-10-2026; antes cabían 300 KB).
    function strAt(l, i, max) { return l.size() <= i || (l[i] is string && l[i].size() <= max); }
    function strs(l, n, max) {
      return l is list && l.size() <= n && strAt(l, 0, max) && strAt(l, 1, max) && strAt(l, 2, max) && strAt(l, 3, max)
        && strAt(l, 4, max) && strAt(l, 5, max) && strAt(l, 6, max) && strAt(l, 7, max);
    }
    // Un favorito del perfil: { dex, shiny }.
    function favAt(l, i) {
      return l.size() <= i || (l[i] is map && l[i].keys().hasOnly(['dex', 'shiny'])
        && l[i].get('dex', 0) is int && l[i].get('shiny', false) is bool);
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals', 'avatar'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3
              && favAt(request.resource.data.favs, 0) && favAt(request.resource.data.favs, 1) && favAt(request.resource.data.favs, 2)))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        // Avatar de entrenador (24-10-2026, data/avatars.js): 0 = ninguno, 1-60 uno de los de Reloaded.
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar <= 60))
        && (!('best' in request.resource.data) || validBest(request.resource.data.best))
        && (!('medals' in request.resource.data) || strs(request.resource.data.medals, 8, 40))
        // El apodo sólo se comprueba si cambia (25-10-2026): ya se comprobó al ponerlo, y
        // leerlo en cada guardado del perfil era 1 lectura de más cada vez (~400.000 al día).
        && ((resource != null && resource.data.get('lower', '') == request.resource.data.lower)
            || getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me())
        && (resource == null || every(resource.data.at, 20));
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    // Los apodos de la pareja: { uid: apodo } con sus dos uids y textos cortos (28-10-2026:
    // antes cabían 500 KB).
    function pairNames(d) {
      return d.names is map && d.names.keys().hasOnly(d.users)
        && d.names.get(d.users[0], '') is string && d.names.get(d.users[0], '').size() <= 24
        && d.names.get(d.users[1], '') is string && d.names.get(d.users[1], '').size() <= 24;
    }

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && pairNames(request.resource.data)
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && pairNames(request.resource.data)
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- ranking ----------

    // Hora de inicio de partida: se quitó el 20-10-2026 (era 1/3 de las escrituras
    // y validEntry la leía en cada marca). Sólo se puede borrar lo que quede.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if false;
    }

    // Una entrada sólo se puede mejorar, nunca empeorar: el tiempo (t) o el
    // daño a Arceus (dmg, desde el 23-10-2026), sin bajar el otro. Anti-trampas:
    //   - (el tope de 45 min se quitó el 23-10-2026: en el minuto 35 Arceus
    //     rompe los objetos y cada legendario es más fuerte; queda uno de 3 h)
    //   - daño a Arceus sólo después del minuto 30 (cuando sale) y como mucho
    //     DPS_MAX por segundo de partida desde entonces (24-10-2026; ya viene
    //     reducido por la Sentencia, ver judgment.js dmgK: 3000/s es más de
    //     60 000/s de golpes de verdad, de sobra para un grupo de 4)
    //   - nombres de hasta 24 letras, dex números y shiny sí/no (24-10-2026:
    //     sin esto un nombre enorme llenaba el resumen del ranking)
    //   - como mucho una marca cada 30 s por tabla (las partidas duran más)
    //   - nivel y derrotados con margen de sobra (un grupo de 4 muy bueno)
    //   (el baneo del admin se mira al entrar en un top 50, en addMine: es lo único
    //    que se ve. Mirarlo en cada marca era leer la partida cada vez, ~300.000
    //    lecturas al día; 25-10-2026.)
    // El jugador i de una marca (si lo hay): nombre corto, Pokémon y si es shiny.
    function who(d, i) {
      return d.uids.size() <= i
        || (d.uids[i] is string && d.uids[i].size() <= 128 && d.names[i] is string && d.names[i].size() <= 24
            && d.dex[i] is int && d.shiny[i] is bool);
    }
    // Sólo las tablas que usa el juego (js/net/ranking.js, boardIds; 28-10-2026: antes se podían
    // crear tablas con cualquier nombre y llenar la base de datos): modo s/g + día, semana, mes,
    // desafío o histórico (este, también por Pokémon). La letra del final es la «generación» de las
    // tablas (GEN); las viejas no la llevan. Una tabla nueva con otro nombre necesita cambiar esto.
    function okBoard(b) {
      return b.matches('^[sg]_(d[0-9]{8}[a-z]?|w[0-9]{4}-[0-9]{2}[a-z]?|m[0-9]{6}[a-z]?|cw[0-9]{4}-[0-9]{2}[a-z]?|all[0-9]*(_p[0-9]{1,4})?)$');
    }
    function validEntry(board, id) {
      let d = request.resource.data;
      let dmg = d.get('dmg', 0);
      return okBoard(board)
        && d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'dmg', 'at'])
        && d.t is int && d.t > 0 && d.t <= 10800
        && dmg is int && dmg >= 0 && (dmg == 0 || (d.t > 1800 && dmg <= (d.t - 1800) * 3000))
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.uids.size() <= 4 && who(d, 0) && who(d, 1) && who(d, 2) && who(d, 3)
        && d.at == request.time
        && (resource == null || every(resource.data.at, 30))
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || (d.t >= resource.data.t && dmg >= resource.data.get('dmg', 0)
              && (d.t > resource.data.t || dmg > resource.data.get('dmg', 0))));
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // Resumen con los dos top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top:  { id: { t, uids, names, dex, shiny, lv, kills } }   tiempo aguantado
    //   dtop: { id: { d, uids, names, dex, shiny } }              daño a Arceus (desde el 23-10-2026)
    //   me:   la fila que añades o mejoras (debe coincidir con tu marca validada,
    //         escrita en la misma transacción: su at es la hora de esta escritura)
    //   ev / dev: la fila que sale del top / del dtop: sólo si entras nueva, el top
    //         ya tiene 50 y es peor que la tuya (24-10-2026: antes se podía echar a
    //         otros sin mejorar nada)
    // Al borrar la cuenta: me = '' y ev (o dev) = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let dold = resource == null ? {} : resource.data.get('dtop', {});
      let dnew = d.get('dtop', {});
      let dev = d.get('dev', '');
      let changed = d.top.diff(old).affectedKeys();
      return okBoard(board) && d.keys().hasOnly(['top', 'me', 'ev', 'dtop', 'dev'])
        && d.top is map && d.top.size() <= 50
        && dnew is map && dnew.size() <= 50
        && d.me is string && d.ev is string && dev is string
        && (d.me == ''
              ? (removeMine(d, old, changed, dold, dnew, dev) || adminRemove(d, old, dold, dnew))
              : addMine(board, d, old, changed, dold, dnew, dev));
    }
    // Moderación: el admin sólo puede QUITAR filas de los dos top.
    function adminRemove(d, old, dold, dnew) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0
        && dold.keys().hasAll(dnew.keys()) && dnew.diff(dold).changedKeys().size() == 0;
    }
    // (Como mucho 7 argumentos por función: dchanged se calcula dentro.)
    function addMine(board, d, old, changed, dold, dnew, dev) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let dchanged = dnew.diff(dold).affectedKeys();
      // La cuenta no puede estar baneada por el admin (saves/{uid}.ban; si aún no ha
      // guardado nunca en la nube, no tiene documento y no está baneada).
      // Y desde el 28-10-2026 tampoco en bans/{uid}: así también se banea a quien nunca
      // ha guardado en la nube (antes el baneo de esas cuentas no hacía nada).
      let sv = /databases/$(database)/documents/saves/$(me());
      return me() in e.uids && e.at == request.time
        && !exists(/databases/$(database)/documents/bans/$(me()))
        && (!exists(sv) || get(sv).data.get('ban', false) == false)
        && changed.hasOnly([d.me, d.ev])
        && dchanged.hasOnly([d.me, dev])
        && (!(d.me in changed) || (d.me in d.top && rowOk(d.top[d.me], e)))
        && (!(d.me in dchanged) || (d.me in dnew && drowOk(dnew[d.me], e)))
        && (d.ev == '' || (d.me in d.top && !(d.me in old) && old.size() >= 50
              && !(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t))
        && (dev == '' || (d.me in dnew && !(d.me in dold) && dold.size() >= 50
              && !(dev in dnew) && dev in dold && dold[dev].d <= e.get('dmg', 0)));
    }
    // La fila del resumen es una COPIA exacta de la marca ya validada (validEntry):
    // también nivel, derrotados y shiny (18-10-2026: sin esto se podía meter
    // texto con código en el "nivel" y se ejecutaba en quien abría el ranking).
    // shiny es opcional: si no hay ninguno, no se pone.
    function rowOk(row, e) {
      return row.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills'])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.lv == e.lv && row.kills == e.kills
        && (!('shiny' in row) || row.shiny == e.shiny);
    }
    function drowOk(row, e) {
      return row.keys().hasOnly(['d', 'uids', 'names', 'dex', 'shiny'])
        && row.d == e.get('dmg', 0) && row.d > 0 && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && (!('shiny' in row) || row.shiny == e.shiny);
    }
    function removeMine(d, old, changed, dold, dnew, dev) {
      let dchanged = dnew.diff(dold).affectedKeys();
      return (d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]) && dchanged.size() == 0)
        || (dev in dold && me() in dold[dev].uids && !(dev in dnew) && dchanged.hasOnly([dev]) && changed.size() == 0);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      // Quitado el 20-10-2026 (era 1/4 de las escrituras): nadie puede escribirlo,
      // así tampoco gastan las versiones viejas del juego. Sólo se puede borrar.
      allow create, update: if false;
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reportes ----------
    // Un reporte por jugador y marca (id "tabla__marca__tuUid"). Los lee y
    // borra el admin desde la pantalla oculta de moderación.
    // Sólo de una marca que existe en una tabla del juego (28-10-2026: con tablas o
    // marcas inventadas se llenaba la lista del admin, se le rompía la pestaña o se le
    // hacía banear a quien no tocaba). Los nombres que pinta el panel salen de la marca.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && okBoard(request.resource.data.board)
        && request.resource.data.e is string && request.resource.data.e.size() <= 160
        && strs(request.resource.data.names, 4, 24)
        && exists(/databases/$(database)/documents/lb/$(request.resource.data.board)/e/$(request.resource.data.e))
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    // ---------- baneos del ranking (28-10-2026) ----------
    // Uno por cuenta baneada (lo mira addMine). Sólo el admin lo lee, lo pone y lo quita.
    // name: el apodo que tenía la marca, para la lista de baneados.
    match /bans/{uid} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['at', 'name'])
        && request.resource.data.at == request.time
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 24;
    }

    // ---------- regalos del admin (21-10-2026) ----------
    // Buzón de cada jugador: el admin le deja monedas o tickets (sólo sumar,
    // nunca quitar) y el juego los apunta en la libreta al entrar (js/core/db.js).
    // Un regalo no se cambia ni se borra: así nunca se cobra dos veces ni se pierde.
    match /gifts/{uid}/g/{gid} {
      allow read: if signedIn() && (me() == uid || admin());
      allow create: if (admin()
        && request.resource.data.keys().hasOnly(['c', 't1', 't10', 'at'])
        && giftAmount(request.resource.data, 'c', 1000000)
        && giftAmount(request.resource.data, 't1', 1000)
        && giftAmount(request.resource.data, 't10', 1000)
        && request.resource.data.get('c', 0) + request.resource.data.get('t1', 0) + request.resource.data.get('t10', 0) > 0
        && request.resource.data.at == request.time)
        || friendGift(uid, gid);
    }
    function giftAmount(d, k, max) { return d.get(k, 0) is int && d.get(k, 0) >= 0 && d.get(k, 0) <= max; }

    // Regalo de un amigo (24-10-2026, js/net/social.js): un ticket ×1, una vez al día
    // a cada amigo. El documento se llama f_<quien regala>_<día UTC desde 1970> y no se
    // puede cambiar: el mismo día no se puede volver a crear. Sólo entre amigos de verdad
    // (amistad aceptada) y con el apodo que tiene en esa amistad.
    function friendGift(uid, gid) {
      let d = request.resource.data;
      let pid = me() < uid ? me() + '_' + uid : uid + '_' + me();
      let fr = get(/databases/$(database)/documents/friendships/$(pid)).data;
      return signedIn() && me() != uid
        && d.keys().hasOnly(['t1', 'from', 'name', 'day', 'at'])
        && d.t1 == 1 && d.from == me() && d.at == request.time
        && d.day is int && d.day == math.floor(request.time.toMillis() / 86400000)
        && gid == 'f_' + me() + '_' + string(d.day)
        && fr.status == 'ok' && me() in fr.users
        && d.name == fr.names[me()];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
