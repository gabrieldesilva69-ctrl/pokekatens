{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s', 'at']) && newData.child('s').isString() && newData.child('s').val().matches(/^(on|play|group|off)$/) && newData.child('at').isNumber() && newData.child('at').val() === now",
        "s": { ".validate": true },
        "at": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('m').child(auth.uid).exists()",
        ".write": "auth != null && $room === auth.uid",
        ".validate": "newData.child('host').val() === $room",
        "host": {
          ".read": "auth != null",
          ".validate": "newData.val() === $room"
        },
        "open": {
          ".read": "auth != null",
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "m": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || root.child('rooms').child($room).child('open').val() === true)",
            ".validate": "($uid === $room || $uid === auth.uid || data.exists() || root.child('rin').child($room).child($uid).exists()) && newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "dex": { ".validate": "newData.isNumber()" },
            "shiny": { ".validate": "newData.isBoolean()" },
            "avatar": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to ? !newData.exists() : (root.child('rooms').child($room).child('m').child(auth.uid).exists() && (auth.uid === $room || $to === $room)))",
              ".validate": "newData.isString() && newData.val().length <= 16000 && $msg.matches(/^[A-Za-z0-9]{1,64}_[0-9][0-9]$/) && $msg.beginsWith(auth.uid + '_') && root.child('rooms').child($room).child('m').child($to).exists()"
            }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "relayUse": {
      "$month": {
        ".read": "auth != null"
      }
    },
    "relay": {
      "$month": {
        ".read": "auth != null",
        ".validate": "$month.matches(/^20[0-9][0-9]-[01][0-9]$/)",
        "t": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + newData.parent().child('u').child(auth.uid).child('mb').val() - (data.parent().child('u').child(auth.uid).child('mb').exists() ? data.parent().child('u').child(auth.uid).child('mb').val() : 0)"
        },
        "u": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "newData.hasChildren(['mb', 'at']) && newData.child('at').val() === now && newData.child('mb').isNumber() && newData.child('mb').val() >= (data.exists() ? data.child('mb').val() : 0) + 1 && newData.child('mb').val() <= (data.exists() ? data.child('mb').val() : 0) + 20 && newData.child('mb').val() <= 2000 && (!data.exists() || data.child('at').val() < now - 50000) && newData.parent().parent().child('t').val() === (data.parent().parent().child('t').exists() ? data.parent().parent().child('t').val() : 0) + newData.child('mb').val() - (data.exists() ? data.child('mb').val() : 0)",
            "mb": { ".validate": true },
            "at": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "rin": {
      "$room": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($room).child('host').exists())",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
